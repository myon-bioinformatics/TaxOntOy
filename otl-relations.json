  "properties": {
    "classes": {
      "dependency": {
        "acyclic": {
          "since": "2026-11-14",
          "reason": "dependsOn の閉路は監査の完了順を止める"
        }
      },
      "hierarchy": {
        "acyclic": {
          "since": "2026-11-15",
          "reason": "階層の循環は分類の誤りとして扱う"
        },
        "transitive": {
          "since": "2026-11-15",
          "reason": "上位から下位への narrower は推移する"
        }
      },
      "similarity": {
        "symmetric": {
          "since": "2026-11-15",
          "reason": "similarTo は両方向を別の辺として保存する"
        }
      }
    },
    "relations": {
      "belongsTo": {
        "domain": {
          "types": [
            "ActionsRun",
            "Branch",
            "Commit",
            "File",
            "PullRequest"
          ],
          "since": "2026-11-21",
          "reason": "監査グラフで Repository へ向かう belongsTo の source は File、ActionsRun、Commit、PullRequest、Branch である"
        },
        "range": {
          "types": [
            "Repository"
          ],
          "since": "2026-11-21",
          "reason": "belongsTo の target は Repository だけである"
        }
      },
      "blocks": {
        "inverse_of": {
          "relation": "dependsOn",
          "since": "2026-11-14",
          "reason": "blocks は dependsOn の逆向きとして監査グラフに足される"
        }
      },
      "dependsOn": {
        "inverse_of": {
          "relation": "blocks",
          "since": "2026-11-14",
          "reason": "監査グラフは dependsOn の逆向きを blocks として足す"
        }
      },
      "narrower": {
        "disjoint_with": [
          {
            "relation": "similarTo",
            "since": "2026-11-15",
            "reason": "階層の端点は類似の端点と重ならない"
          }
        ]
      },
      "similarTo": {
        "disjoint_with": [
          {
            "relation": "narrower",
            "since": "2026-11-15",
            "reason": "類似の端点は階層の端点と重ならない"
          }
        ]
      },
      "subtree": {
        "disjoint_with": [
          {
            "relation": "vendor",
            "since": "2026-11-21",
            "reason": "同じリポジトリの同じパスを subtree と vendor の両方で配ると二重配布になる"
          }
        ]
      },
      "vendor": {
        "disjoint_with": [
          {
            "relation": "subtree",
            "since": "2026-11-21",
            "reason": "同じリポジトリの同じパスを vendor と subtree の両方で配ると二重配布になる"
          }
        ]
