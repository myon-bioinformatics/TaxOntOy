{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/myon-bioinformatics/TaxOntOy/otl-relations.schema.json",
  "title": "TaxOntOy relation classification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "audit", "concepts", "cases", "direction", "excluded", "properties"],
  "properties": {
    "schema": {"const": "taxontoy-relations/2"},
    "audit": {"$ref": "#/$defs/profile"},
    "concepts": {"$ref": "#/$defs/profile"},
    "cases": {"$ref": "#/$defs/profile"},
    "repos": {
      "description": "Optional profile of relations between repositories. Documents that omit it stay valid taxontoy-relations/2.",
      "$ref": "#/$defs/profile"
    },
    "direction": {
      "type": "object",
      "description": "Declared direction of every classified relation. JSON object keys must be unique; the Python validator rejects duplicates.",
      "additionalProperties": {"enum": ["forward", "mutual", "undirected"]}
    },
    "excluded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit", "concepts", "cases"],
      "properties": {
        "audit": {"$ref": "#/$defs/nameList"},
        "concepts": {"$ref": "#/$defs/nameList"},
        "cases": {"$ref": "#/$defs/nameList"},
        "repos": {"$ref": "#/$defs/nameList"}
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classes", "relations"],
      "properties": {
        "classes": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/classDeclaration"}
        },
        "relations": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/relationDeclaration"}
        }
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "minProperties": 1,
      "description": "Relation name to semantic class. TopOntoLogy reads these values as strings. Keys must be unique.",
      "additionalProperties": {
        "enum": [
          "affirmation",
          "dependency",
          "hierarchy",
          "hypothesis",
          "judgment-record",
          "negation",
          "overlap",
          "similarity",
          "unknown-element"
        ]
      }
    },
    "nameList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["since", "reason"],
      "properties": {
        "since": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "partner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "since", "reason"],
      "properties": {
        "relation": {"type": "string", "minLength": 1},
        "since": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "classDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transitive": {"$ref": "#/$defs/evidence"},
        "symmetric": {"$ref": "#/$defs/evidence"},
        "acyclic": {"$ref": "#/$defs/evidence"}
      }
    },
    "relationDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transitive": {"$ref": "#/$defs/evidence"},
        "symmetric": {"$ref": "#/$defs/evidence"},
        "acyclic": {"$ref": "#/$defs/evidence"},
        "inverse_of": {"$ref": "#/$defs/partner"},
        "disjoint_with": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/partner"}
        }
      }
    }
  }
}
